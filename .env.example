# Copier ce fichier en .env et remplir les valeurs

# Django  (en PRODUCTION : DEBUG=False + un SECRET_KEY long et aléatoire)
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Requis en prod derrière HTTPS (sinon login/POST en 403). Ex : https://mondomaine.com
CSRF_TRUSTED_ORIGINS=

# Base de données PostgreSQL
# En prod managée (Render/Heroku), une seule variable suffit et prime sur les DB_* :
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_NAME=eduapp
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# SMS / WhatsApp (à configurer plus tard)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=EduApp

# IA — génération des leçons (portail élève)
# Requis : apps/lessons/services.py. Obtenir sur console.anthropic.com
ANTHROPIC_API_KEY=

# Monitoring des erreurs (prod, optionnel mais recommandé) — DSN sur sentry.io
SENTRY_DSN=
SENTRY_ENV=production
